# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# Telegram download server URL (reachable from the browser)
# Local dev:        http://localhost:8300
# Docker compose:   http://localhost:8300  (same host as browser)
# Deployment:       https://your-server:8200
VITE_TELEGRAM_DOWNLOADER_URL=http://localhost:8300
