# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# ===========================================
# Studio Audio backend (never prefix secrets with VITE_)
# ===========================================
FREESOUND_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=
FREESOUND_CALLBACK_URL=http://freesound.org/home/app_permissions/permission_granted/
PIXABAY_API_KEY=
STUDIO_AUDIO_PORT=8787
VITE_STUDIO_AUDIO_API_URL=http://127.0.0.1:8787/api/studio-audio
